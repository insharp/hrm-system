# ═══════════════════════════════════════════════════════════════════════════════
# HRM System — Environment Variables
# ═══════════════════════════════════════════════════════════════════════════════
#
# INSTRUCTIONS:
#   1. Copy this file:  cp .env.example .env
#   2. Fill in every value marked with  <REPLACE>
#   3. Never commit the real .env — it is already in .gitignore
#
# This file is the single source of truth for ALL services:
#   • backend  (FastAPI)
#   • ai_service (screening microservice — reads ../backend/.env automatically)
#   • frontend  (Next.js — has its own .env.local for NEXT_PUBLIC_ vars only)
# ═══════════════════════════════════════════════════════════════════════════════


# ── Environment ───────────────────────────────────────────────────────────────
# development (default) → the app runs Base.metadata.create_all() at startup for
#                         convenience, so contributors can boot without migrations.
# production            → create_all() is SKIPPED; the schema is owned by Alembic.
#                         Run `alembic upgrade head` as part of your deploy.
ENVIRONMENT=development


# ── Database ──────────────────────────────────────────────────────────────────
# Full PostgreSQL connection string.
# Format: postgresql://<user>:<password>@<host>:<port>/<database>
DATABASE_URL=postgresql://postgres:<REPLACE_DB_PASSWORD>@localhost:5432/hrm_db


# ── JWT / Auth ────────────────────────────────────────────────────────────────
# Generate a strong secret: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=<REPLACE_WITH_RANDOM_64_CHAR_HEX>
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7


# ── Cookie Security ───────────────────────────────────────────────────────────
# Development:  COOKIE_SECURE=false   (allows HTTP)
# Production:   COOKIE_SECURE=true    (HTTPS only — required for production)
COOKIE_SECURE=false
COOKIE_SAMESITE=lax


# ── Rate Limiting ─────────────────────────────────────────────────────────────
RATE_LIMIT_ENABLED=true
LOGIN_RATE_LIMIT=5
LOGIN_RATE_WINDOW_SECONDS=60
OTP_RATE_LIMIT=5
OTP_RATE_WINDOW_SECONDS=300
# true ONLY when running behind a reverse proxy / load balancer that sets
# X-Forwarded-For. Leave false when clients reach the API directly.
TRUST_PROXY_HEADERS=false
# Shared secret for POST /notifications/internal (service-to-service pushes).
# Leave empty to keep that endpoint disabled. Never reuse "hrm-internal-2024".
INTERNAL_API_KEY=

# Days an emailed temporary password (new employee / "resend login details")
# remains valid for the mandatory first-login change.
TEMP_PASSWORD_EXPIRE_DAYS=7


# ── SMTP (outgoing email) ─────────────────────────────────────────────────────
# Gmail example: enable "App Passwords" in your Google account and paste it below.
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=<REPLACE_WITH_EMAIL>
MAIL_PASSWORD=<REPLACE_WITH_APP_PASSWORD>
MAIL_FROM=<REPLACE_WITH_EMAIL>


# ── IMAP (incoming email — document request inbox) ────────────────────────────
# Defaults to MAIL_USERNAME / MAIL_PASSWORD if not set.
# IMAP_SERVER=imap.gmail.com
# IMAP_USER=<REPLACE_WITH_EMAIL>
# IMAP_PASSWORD=<REPLACE_WITH_APP_PASSWORD>
EMAIL_POLL_INTERVAL_SECONDS=300


# ── Google reCAPTCHA v2 ───────────────────────────────────────────────────────
# Get keys from: https://www.google.com/recaptcha/admin
# Secret key goes here (backend). Site key goes in frontend/.env.local.
RECAPTCHA_SECRET_KEY=<REPLACE_WITH_RECAPTCHA_SECRET_KEY>


# ── AI Provider ───────────────────────────────────────────────────────────────
# This section is also read by ai_service/ — no separate ai_service/.env needed.
#
# ── Groq (RECOMMENDED — free, generous quota) ─────────────────────────────────
#   1. Sign up at https://console.groq.com (free, no credit card)
#   2. Create an API key (starts with gsk_...)
#   3. Set the values below:
#
#   AI_PROVIDER=groq
#   AI_MODEL=llama-3.3-70b-versatile      ← best quality (free)
#   AI_MODEL_FALLBACK=llama-3.1-8b-instant ← fast fallback (free)
#   AI_API_KEY=gsk_...
#
# ── Gemini (Google) ───────────────────────────────────────────────────────────
#   AI_PROVIDER=gemini
#   AI_MODEL=gemini-2.0-flash-lite
#   AI_MODEL_FALLBACK=gemini-1.5-flash-8b
#   AI_API_KEY=AIzaSy...
#
# ── OpenAI (ChatGPT) ──────────────────────────────────────────────────────────
#   AI_PROVIDER=openai
#   AI_MODEL=gpt-4o-mini
#   AI_API_KEY=sk-...
#
# ── Anthropic Claude ──────────────────────────────────────────────────────────
#   AI_PROVIDER=claude
#   AI_MODEL=claude-3-5-haiku-20241022
#   AI_API_KEY=sk-ant-...
#
AI_PROVIDER=groq
AI_MODEL=llama-3.3-70b-versatile
AI_MODEL_FALLBACK=llama-3.1-8b-instant
AI_API_KEY=<REPLACE_WITH_AI_API_KEY>

# URL where the backend reaches the ai_service (change if running in Docker)
AI_SERVICE_URL=http://127.0.0.1:8001


# ── Storage Backend ───────────────────────────────────────────────────────────
# STORAGE_BACKEND=local    Files stored on disk (development / single-server)
# STORAGE_BACKEND=s3       Files stored in S3-compatible object store (production)
STORAGE_BACKEND=local

# S3 / MinIO settings — only used when STORAGE_BACKEND=s3
#
#   MinIO (local S3 for testing):
#     1. docker compose up -d minio createbuckets
#     2. Set STORAGE_BACKEND=s3 and use the values below as-is
#
#   Real AWS S3:
#     1. Create a bucket + IAM user with s3:PutObject/GetObject/DeleteObject
#     2. Set STORAGE_BACKEND=s3, fill in your real values, leave AWS_S3_ENDPOINT_URL blank
#
AWS_S3_BUCKET=hrm-uploads
AWS_ACCESS_KEY_ID=<REPLACE_WITH_ACCESS_KEY>
AWS_SECRET_ACCESS_KEY=<REPLACE_WITH_SECRET_KEY>
AWS_REGION=us-east-1
AWS_S3_ENDPOINT_URL=http://localhost:9000


# ── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins.
# Production example: CORS_ORIGINS=https://hrm.yourcompany.com
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000


# ── File Upload Limits ────────────────────────────────────────────────────────
MAX_FILE_SIZE_BYTES=10485760   # 10 MB

# ── Time zone ─────────────────────────────────────────────────────────────────
# Organisation's UTC offset in minutes (default 330 = Sri Lanka, UTC+5:30).
# Timestamps are stored in UTC; work days, weeks, event reminders and
# "today/tomorrow" wording follow this local offset.
APP_TZ_OFFSET_MINUTES=330
